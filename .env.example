# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API (e.g. 1 on Render/Fly/Cloud Run)
TRUST_PROXY=0

# Supabase (server-side only — never ship these to clients)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256 JWT secret. If empty, tokens are verified by calling Supabase Auth instead.
SUPABASE_JWT_SECRET=

# Auth emails
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
INVITE_REDIRECT_URL=http://localhost:5173/accept-invite

# Invoices
INVOICE_BUCKET=invoices
SIGNED_URL_TTL_SECONDS=600
DEFAULT_CURRENCY=USD
COMPANY_NAME=Your Company Pvt. Ltd.
COMPANY_CONTACT_NAME=Mr. Contact Person
# Separate address lines with |
COMPANY_ADDRESS=Street, Area,|City, State PIN, Country
COMPANY_EMAIL=accounts@example.com
COMPANY_PHONE=+00 00000 00000
COMPANY_LOGO_PATH=assets/logo.png
COMPANY_SIGNATURE_PATH=assets/signature.png

# Bank details printed on project (client) invoices
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NUMBER=
BANK_SWIFT_CODE=
BANK_ACCOUNT_TYPE=

# Project invoices
# Printed before the first name: "Payment for Backend Developer Er. Sachin"
PROJECT_INVOICE_NAME_PREFIX="Er. "
# Per-day rate rounding for leave deductions (0 = whole units, as on invoice S2534)
PROJECT_INVOICE_PER_DAY_DECIMALS=0
# Default due date = this day of the month after the issue date
PROJECT_INVOICE_DUE_DAY=5
# Lowest suggested client invoice number (S2535); after that: highest used + 1
PROJECT_INVOICE_START_NUMBER=2535
